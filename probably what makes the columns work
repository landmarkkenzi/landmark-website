/* =========================================
   PRODUCT GALLERY
   Desktop: 2-column image grid
   Mobile: horizontal slideshow
   ========================================= */

/* ---------- Base ---------- */

.product__photos {
  direction: ltr;
  width: 100%;
}

.product__main-photos {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  position: relative;
  width: 100%;
}

.product-slideshow {
  position: relative;
  width: 100%;
}

.product-main-slide {
  width: 100%;
}


/* =========================================
   DESKTOP
   2-column image grid
   ========================================= */

@media only screen and (min-width: 590px) {

  .product__main-photos {
    width: 100%;
  }

  .product-slideshow.flickity-enabled {
    display: block;
    height: auto !important;
    overflow: visible;
    width: 100%;
  }

  .product-slideshow.flickity-enabled .flickity-viewport {
    height: auto !important;
    overflow: visible;
    width: 100%;
  }

  .product-slideshow.flickity-enabled .flickity-slider {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    height: auto !important;
    position: static;
    transform: none !important;
    width: 100%;
  }

  .product-slideshow.flickity-enabled .product-main-slide {
    display: block !important;
    height: auto !important;
    left: auto !important;
    position: relative !important;
    top: auto !important;
    transform: none !important;
    width: auto !important;
  }

  .product-main-slide .image-wrap {
    width: 100%;
  }

  .product-main-slide .image-wrap img {
    display: block;
    height: auto;
    width: 100%;
  }

  /* Hide Flickity controls on desktop */
  .product-slideshow .flickity-prev-next-button,
  .product-slideshow .flickity-page-dots {
    display: none !important;
  }

  /* Hide thumbnail rail on desktop */
  .product__thumbs {
    display: none;
  }

}


/* =========================================
   MOBILE
   Single-image horizontal slideshow
   ========================================= */

@media only screen and (max-width: 589px) {

  .product__photos {
    display: block;
    width: 100%;
  }

  .product__main-photos {
    display: block;
    overflow: hidden;
    width: 100%;
  }

  .product-slideshow {
    display: block;
    overflow: hidden;
    width: 100%;
  }

  .product-slideshow.flickity-enabled {
    display: block;
    overflow: hidden;
    width: 100%;
  }

  .product-slideshow.flickity-enabled .flickity-viewport {
    overflow: hidden;
    width: 100%;
  }

  .product-slideshow.flickity-enabled .flickity-slider {
    width: 100%;
  }

  .product-slideshow .product-main-slide {
    display: block !important;
    width: 100%;
  }

  .product-main-slide .image-wrap {
    width: 100%;
  }

  .product-main-slide .image-wrap img {
    display: block;
    height: auto;
    width: 100%;
  }

  /* Mobile zoom button */
  .product-slideshow .product__photo-zoom {
    bottom: 0;
    cursor: zoom-in;
    opacity: 0;
    position: absolute;
    right: 0;
    transition: opacity 0.5s ease-out;
  }

  .product-slideshow .is-selected .product__photo-zoom {
    opacity: 1;
  }

  .product__main-photos .product__photo-zoom {
    margin-bottom: 10px;
    margin-right: 10px;
    padding: 6px;
  }

  /* Hide thumbnails on mobile */
  .product__thumbs {
    display: none;
  }

}


/* =========================================
   THUMBNAILS
   ========================================= */

.product__thumbs {
  overflow: hidden;
  position: relative;
}

.product__thumbs--scroller {
  -ms-overflow-style: -ms-autohiding-scrollbar;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.product__thumbs--scroller::-webkit-scrollbar {
  height: 0;
  width: 0;
}

.product__thumb-item {
  border: 2px solid transparent;
}

.product__thumb-item a.is-active,
.product__thumb-item a:focus {
  outline: none;
}

.product__thumb-item a.is-active:before,
.product__thumb-item a:focus:before {
  bottom: 0;
  box-shadow: inset 0 0 0 2px var(--colorTextBody);
  content: "";
  display: block;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 1;
}

.product__thumb-item a:active:before {
  content: none;
}

.product__thumb {
  cursor: pointer;
  display: block;
  position: relative;
}

.product__thumb > .image-wrap img {
  height: auto;
  position: static;
}

.product__thumb-icon {
  background-color: var(--colorTextBody);
  border-radius: 100px;
  font-size: 0;
  opacity: 0;
  padding: 6px;
  position: absolute;
  right: 5px;
  top: 5px;
  transition: opacity 0.5s ease;
  z-index: 1;
}

.aos-animate .product__thumb-icon {
  opacity: 1;
}

.product__thumb-icon .icon {
  fill: var(--colorBody);
  height: 10px;
  width: 10px;
}

@media only screen and (min-width: 590px) {

  .product__thumb-icon .icon {
    height: 13px;
    width: 13px;
  }

}


/* =========================================
   THUMBNAIL ARROWS
   ========================================= */

.product__thumb-arrow {
  background: var(--colorBody);
  border-radius: 0;
  color: var(--colorTextBody);
  padding: 0;
  position: absolute;
  transform: none;
  z-index: 2;
}

.product__thumb-arrow .icon {
  display: inline-block;
  height: 10px;
  width: 6px;
}


/* =========================================
   PRICE / QUANTITY
   ========================================= */

.product__policies {
  font-size: 0.85em;
  margin-top: 6.6px;
}
