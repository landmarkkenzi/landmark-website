<!-- =========================================
     MODAL JAVASCRIPT
     ========================================= -->

<script>
(function() {

  const modal = document.getElementById('nps-modal');
  const modalTitle = document.getElementById('nps-modal-title');
  const modalClose = document.getElementById('nps-modal-close');
  const shopGrid = document.getElementById('nps-shop-grid');
  const shopEmpty = document.getElementById('nps-shop-empty');

  if (!modal || !modalTitle || !modalClose || !shopGrid || !shopEmpty) {
    return;
  }

  /* =========================================
     PRODUCT HANDLES PER PARK
     Fill in the handles for each park below.
     A handle is the part of the URL after
     /products/  e.g. /products/trail-mug
     ========================================= */

  const PARK_PRODUCTS = {
    'Yosemite National Park': [],
    'Joshua Tree National Park': [],
    'Saguaro National Park': [],
    'Rocky Mountain National Park': [],
    'Bryce Canyon National Park': [],
    'Great Smoky Mountains National Park': [],
    'Everglades National Park': [],
    'Denali National Park': [],
    'Haleakala National Park': [],
    'Isle Royale': [],
    'Crater Lake': [],
    'Canyonlands': [],
    'Glacier': [],
    'Rainier': [],
    'Yellowstone': [],
    'Mammoth Cave': [],
    'Kings Canyon': [],
    'Capitol Reef': [],
    'Acadia': [],
    'Petrified Forest': [],
    'Anchorage': [],
    'Pinnacles': [],
    'Wind Cave': [],
    'New River Gorge': [],
    'Mesa Verde': [],
    'Lassen Volcanic': [],
    'Black Canyon': [],
    'Cuyahoga': [],
    'Big Bend': [ 'big-bend-national-park-poster' ]
  };

  const productCache = {};

  function formatMoney(cents) {
    // Adjust if your store's currency/locale isn't USD
    return '$' + (cents / 100).toFixed(2);
  }

  function fetchProduct(handle) {
    if (productCache[handle]) {
      return Promise.resolve(productCache[handle]);
    }
    return fetch('/products/' + handle + '.js')
      .then(function(res) {
        if (!res.ok) throw new Error('Not found: ' + handle);
        return res.json();
      })
      .then(function(data) {
        productCache[handle] = data;
        return data;
      })
      .catch(function(err) {
        console.warn('Could not load product', handle, err);
        return null;
      });
  }

  function buildCard(product) {
    const variant = product.variants && product.variants[0];
    const price = variant ? formatMoney(variant.price) : '';
    const image = product.featured_image || (product.images && product.images[0]) || '';

    const a = document.createElement('a');
    a.className = 'nps-shop-card';
    a.href = '/products/' + product.handle;

    a.innerHTML =
      (image ? '<img src="' + image + '" alt="' + product.title + '" loading="lazy">' : '') +
      '<p class="nps-shop-card__title">' + product.title + '</p>' +
      '<p class="nps-shop-card__price">' + price + '</p>';

    return a;
  }


  /* =========================================
     OPEN MODAL
     ========================================= */

  document.addEventListener('click', function(event) {

    const marker = event.target.closest('.nps-map-marker');
    if (!marker) return;

    const name = marker.getAttribute('data-name');
    const handles = PARK_PRODUCTS[name] || [];

    modalTitle.textContent = name;
    shopGrid.innerHTML = '';
    shopEmpty.hidden = true;

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    if (!handles.length) {
      shopEmpty.hidden = false;
      return;
    }

    Promise.all(handles.map(fetchProduct)).then(function(products) {
      const found = products.filter(Boolean);
      if (!found.length) {
        shopEmpty.hidden = false;
        return;
      }
      found.forEach(function(product) {
        shopGrid.appendChild(buildCard(product));
      });
    });

  });


  /* =========================================
     CLOSE MODAL
     ========================================= */

  function closeModal() {

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');

    modalTitle.textContent = '';
    shopGrid.innerHTML = '';
    shopEmpty.hidden = true;

    document.body.style.overflow = '';

  }


  modalClose.addEventListener('click', closeModal);


  /* =========================================
     CLOSE WHEN CLICKING OUTSIDE CONTENT
     ========================================= */

  modal.addEventListener('click', function(event) {

    if (event.target === modal) {
      closeModal();
    }

  });


  /* =========================================
     CLOSE WITH ESCAPE KEY
     ========================================= */

  document.addEventListener('keydown', function(event) {

    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }

  });

})();
</script>
