<style>
/* =========================================
   NATIONAL PARK MAP
   ========================================= */
.nps-map-fullscreen {
  width: 100vw;
  max-width: none;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: 40px;
  box-sizing: border-box;
}
.nps-map-wrapper {
  position: relative;
  width: 100%;
}
.nps-map-image {
  display: block;
  width: 100%;
  aspect-ratio: 2054 / 1442;
  height: auto;
}


/* =========================================
   MAP MARKERS
   ========================================= */

.nps-map-marker {
  position: absolute;
  width: clamp(25px, 2.2vw, 42px);
  height: clamp(25px, 2.2vw, 42px);
  transform: translate(-50%, -50%);
  padding: 0;
  margin: 0;
  border: 2px solid #f43f00;
  border-radius: 50%;
  background: #f43f00;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  appearance: none;
  -webkit-appearance: none;
  font-family: Arial, sans-serif;
  font-size: clamp(18px, 2vw, 28px);
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;


  transition:
    transform 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}


/* PLUS SIGN */
.nps-map-marker::before {
  content: "+";
  display: block;
  line-height: 1;
}


/* Hover */
.nps-map-marker:hover {
  transform: translate(-50%, -50%) scale(1.15);
  background: #ffffff;
  color: #383838;
  border-color: #383838;
}


/* Keyboard focus */
.nps-map-marker:focus-visible {
  outline: 3px solid #383838;
  outline-offset: 4px;
}


