/* =========================================
   MODAL
   ========================================= */

.nps-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 30px;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.72);
  z-index: 999999;
  line-height: normal;
}

.nps-modal.is-open {
  display: flex;
}


/* =========================================
   MODAL CONTENT
   ========================================= */

.nps-modal-content {
  position: relative;
  width: min(1100px, 100%);
  max-height: calc(100vh - 60px);
  overflow-y: auto;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 8px;
  padding: 40px 32px 32px;
}


/* Park name */

.nps-modal-title {
  margin: 0 0 24px;
  padding: 0;
  color: #383838;
  font-family: inherit;
  font-size: 24px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}


/* =========================================
   SHOPPABLE PRODUCT GRID
   ========================================= */

.nps-shop-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.nps-shop-card {
  display: flex;
  flex-direction: column;
  text-align: center;
  text-decoration: none;
  color: inherit;
}

.nps-shop-card img {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 4px;
  margin-bottom: 10px;
  background: #f4f4f4;
}

.nps-shop-card__title {
  font-size: 14px;
  margin: 0 0 4px;
}

.nps-shop-card__price {
  font-size: 14px;
  color: #555;
  margin: 0;
}

.nps-shop-empty {
  text-align: center;
  color: #777;
  padding: 40px 0;
  margin: 0;
}


/* =========================================
   CLOSE BUTTON
   ========================================= */

.nps-modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #383838;
  font-family: Arial, sans-serif;
  font-size: 25px;
  line-height: 38px;
  text-align: center;
  cursor: pointer;
  z-index: 20;
  appearance: none;
  -webkit-appearance: none;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}

.nps-modal-close:hover {
  background: #383838;
  color: #ffffff;
}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {

