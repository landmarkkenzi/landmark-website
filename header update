        class="custom-header-logo-image"
        width="{{ section.settings.logo.width }}"
        height="{{ section.settings.logo.height }}"
      >

    {% else %}

      <span class="custom-header-logo-text">
        {{ shop.name }}
      </span>

    {% endif %}

  </a>

</div>


          <!-- NAVIGATION: 50% -->

          <div
            class="custom-header-navigation"
            role="navigation"
            aria-label="Primary"
          >

            {%- render 'header-desktop-nav',
              section: section,
              main_menu: main_menu,
              hover_menu: section.settings.hover_menu
            -%}

          </div>


          <!-- SEARCH: 25% -->

          <div class="custom-header-search">

            <form
              action="{{ routes.search_url }}"
              method="get"
              role="search"
              class="custom-header-search-form"
            >

              <input
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="Search"
                aria-label="Search"
              >

              <button
                type="submit"
                aria-label="Search"
              >

                <svg
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <circle cx="9" cy="9" r="7"/>
                  <path d="M14 14l4 4"/>
                </svg>

              </button>

            </form>

          </div>

        </div>

      </div>

    </header>

  </div>

</div>



